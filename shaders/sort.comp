#version 460 core

layout(local_size_x = 2) in;

layout(std430, binding = 6) buffer sortSSBO
{
	int numbers[];
};

void swap(int i, int j)
{
	int temp = numbers[i];
	numbers[i] = numbers[j];
	numbers[j] = temp;
}

void main()
{
	int i = int(gl_GlobalInvocationID.x) - 1;

	if (numbers[i] > numbers[i + 1])
	{
		swap(0, 1);
	}
}